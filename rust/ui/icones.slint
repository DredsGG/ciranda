        if nome == "bug" { return "M12 7H12A5 5 0 0 1 17 12V15A5 5 0 0 1 12 20H12A5 5 0 0 1 7 15V12A5 5 0 0 1 12 7Z M9.5 7V5.5a2.5 2.5 0 0 1 5 0V7 M12 11v9 M3 13h4 M17 13h4 M4 8l3 2 M20 8l-3 2 M4 19l3-2 M20 19l-3-2"; }
        if nome == "fechar" { return "M6 6l12 12 M18 6L6 18"; }
