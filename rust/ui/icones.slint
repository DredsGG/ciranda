        if nome == "globo" { return "M3 12A9 9 0 1 0 21 12A9 9 0 1 0 3 12Z M3 12h18 M12 3a14 14 0 0 1 0 18 M12 3a14 14 0 0 0 0 18"; }
        return "";
    }
    pure public function cheio(nome: string) -> bool {
        return nome == "play" || nome == "pause" || nome == "anterior" || nome == "proximo";
    }
}
