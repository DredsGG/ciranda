        if nome == "sairtela" { return "M8 3v3a2 2 0 0 1-2 2H3 M21 8h-3a2 2 0 0 1-2-2V3 M3 16h3a2 2 0 0 1 2 2v3 M16 21v-3a2 2 0 0 1 2-2h3"; }
        if nome == "pasta" { return "M3 7.5A2.5 2.5 0 0 1 5.5 5H9l2 2.2h7.5A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"; }
        if nome == "pastamais" { return "M3 7.5A2.5 2.5 0 0 1 5.5 5H9l2 2.2h7.5A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z M12 10.5v6 M9 13.5h6"; }
        if nome == "foto" { return "M6 3H18A3 3 0 0 1 21 6V18A3 3 0 0 1 18 21H6A3 3 0 0 1 3 18V6A3 3 0 0 1 6 3Z M7 9A2 2 0 1 0 11 9A2 2 0 1 0 7 9Z M21 15.5l-4.6-4.6a1.5 1.5 0 0 0-2.1 0L5 20"; }
        if nome == "video" { return "M5.5 5H18.5A3 3 0 0 1 21.5 8V16A3 3 0 0 1 18.5 19H5.5A3 3 0 0 1 2.5 16V8A3 3 0 0 1 5.5 5Z M10 9.2v5.6l4.6-2.8z"; }
        if nome == "relogio" { return "M3 12A9 9 0 1 0 21 12A9 9 0 1 0 3 12Z M12 7v5l3 2"; }
        if nome == "buscar" { return "M4 11A7 7 0 1 0 18 11A7 7 0 1 0 4 11Z M20 20l-3.5-3.5"; }
