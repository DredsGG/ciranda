        if nome == "repetir" { return "M17 2l4 4-4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 0 1-4 4H3"; }
        if nome == "repetir1" { return "M17 2l4 4-4 4 M3 11v-1a4 4 0 0 1 4-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 0 1-4 4H3 M11 10.5l1.5-1v5"; }
        if nome == "volume" { return "M11 5 6 9H3v6h3l5 4z M15.5 8.5a5 5 0 0 1 0 7 M18.5 5.5a9.5 9.5 0 0 1 0 13"; }
        if nome == "mudo" { return "M11 5 6 9H3v6h3l5 4z M22 9l-6 6 M16 9l6 6"; }
        if nome == "lista" { return "M9 6h12 M9 12h12 M9 18h12 M4 6h.01 M4 12h.01 M4 18h.01"; }
